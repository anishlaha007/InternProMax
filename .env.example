# Password for the dashboard and the Chrome extension (required).
IPM_PASSWORD=change-me-to-something-long
# Host names you'll open it with, comma separated (Tailscale name, IP, or your domain).
IPM_ALLOWED_HOSTS=internpromax,100.64.0.1
# Address on the host to publish port 8420 on (your Tailscale IP, or 127.0.0.1 behind a proxy).
IPM_PUBLISH=127.0.0.1
