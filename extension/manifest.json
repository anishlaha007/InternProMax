{
  "manifest_version": 3,
  "name": "InternProMax: Autofill & Tracker",
  "short_name": "InternProMax",
  "version": "0.1.0",
  "description": "Autofills internship applications from your InternProMax profile, uploads your tailored resume, and tracks submissions automatically.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "InternProMax",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/fields.js", "content/fill.js", "content/panel.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
